{
  "name": "@geoengine/biois-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "npm run generate-favicon",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "prettier": "prettier",
    "lint": "ng lint && npx eslint ./scripts/**/*.ts",
    "generate-favicon": "tsx ./scripts/favicon.ts"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/cdk": "~22.1.2",
    "@angular/common": "^22.1.2",
    "@angular/compiler": "^22.1.2",
    "@angular/core": "^22.1.2",
    "@angular/forms": "^22.1.2",
    "@angular/material": "~22.1.2",
    "@angular/platform-browser": "^22.1.2",
    "@angular/router": "^22.1.2",
    "@angular/service-worker": "^22.1.2",
    "@fontsource/material-icons": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@geoengine/biois": "file:../api-client/typescript",
    "@jsonjoy.com/json-pointer": "^18.28.0",
    "ajv": "^8.20.0",
    "marked": "^18.0.10",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "ya-json-schema-types": "^2.0.2",
    "zod": "^4.4.3",
    "zod-from-json-schema": "^0.5.6"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "22.1.0",
    "eslint": "^10.8.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "^4.1.11"
  }
}
